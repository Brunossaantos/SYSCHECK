RewriteEngine On
RewriteBase /syscheck/

# =============================
# SEGURANÇA
# =============================

# impedir listagem de diretórios
Options -Indexes

# bloquear acesso a arquivos sensíveis
<FilesMatch "\.(env|log|ini|conf|sql)$">
    Require all denied
</FilesMatch>

# bloquear acesso direto às pastas internas
RewriteRule ^src/views/public/ - [L]
RewriteRule ^src/views/fotos_chamados/ - [L]
RewriteRule ^src/(controllers|models|rn|functions|logs)/ - [F,L]

# =============================
# ROUTER DO SISTEMA
# =============================

# redirecionar tudo para index.php exceto arquivos existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]